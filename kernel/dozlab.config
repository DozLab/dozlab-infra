# DozLab additions to Firecracker's CI config (firecracker-6.1.155.config), merged on top of it
# by the Dockerfile's kernel stage. Every line here must end up in the built kernel's .config;
# the build fails if one is dropped (for example by an unmet dependency).
#
# Firecracker's CI kernels have no module support, so everything is built in (=y).

# Shows as 6.1.155-dozlab in `uname -r`, so a VM tells which kernel it runs
CONFIG_LOCALVERSION="-dozlab"

# kube-proxy (iptables mode) writes rules with these matches and targets
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y

# conntrack over netlink: kube-proxy clears stale UDP conntrack entries
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CT_NETLINK=y

# nf_tables: the iptables in kube-proxy's and the node's images uses the nft backend, and
# kube-proxy's nftables mode needs it directly
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
